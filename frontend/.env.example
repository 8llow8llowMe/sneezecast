# 프론트엔드 환경변수 예시. 복사해서 `.env.local` 로 쓴다 (`.env.local` 은 커밋하지 않는다).
#
# `NEXT_PUBLIC_` 값은 **빌드 시점에 번들로 인라인**된다. dev / prod 를 각각 빌드해야 하고,
# 누구나 번들에서 읽을 수 있으므로 비밀값을 넣지 않는다. 읽는 곳은 src/lib/env.client.ts 하나다.

# 사이트 주소 — 메타데이터 절대 URL 기준
#   로컬 http://localhost:3000 / dev https://dev.sneezecast.com / prod https://www.sneezecast.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API 게이트웨이 주소. 로컬 인프라를 두지 않으므로 로컬 개발도 dev 게이트웨이를 쓴다
# (게이트웨이 CORS 가 http://localhost:* 를 허용한다)
#   dev https://api-dev.sneezecast.com / prod https://api.sneezecast.com
NEXT_PUBLIC_API_BASE_URL=https://api-dev.sneezecast.com
